<nav aria-label="Main">
<a class="brand" href="/">
<span>{{ site.businessName }}</span>
</a>

<button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-menu">
<span class="nav-toggle-bars" aria-hidden="true"><span></span><span></span><span></span></span>
<span class="nav-toggle-label">Menu</span>
</button>

<div class="nav-panel" id="nav-menu">
<ul>
{% for item in nav.primary %}
<li><a href="{{ item.url }}"{% if page.url == item.url %} class="on" aria-current="page"{% endif %}>{{ item.label }}</a></li>
{% endfor %}
</ul>
{# Where it would point at the page you're already on, it becomes an in-page
   jump to the booking options rather than disappearing — a nav that loses a
   button on one page reads as a rendering fault, and the action is still
   useful once you are there. #}
{% set ctaTarget = site.bookingUrl or '/contact/' %}
{% if ctaTarget == page.url %}{% set ctaTarget = '#book' %}{% endif %}
<a class="btn btn-sm" href="{{ ctaTarget }}">Book an intro call</a>
</div>
</nav>
