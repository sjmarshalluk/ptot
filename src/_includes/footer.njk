{% from "shape.njk" import shape %}
<footer>
{# Tonal, not a brand colour: the footer columns are fixed-width and packed
   left, so how much room is left beside them changes with the viewport and the
   shape ends up under the last column at some widths. A lighter tint of the
   surface itself can sit behind text at any width without touching contrast —
   see the fill override in ptot.css. #}
{{ shape('blob', 'yellow', 'md', 'gutter-r') }}
<div class="fwrap">

<div class="fintro">
<p class="fname">{{ site.businessName }}</p>
<p class="frole">Pediatric occupational therapy, in your home, out in the community, and remotely by video.</p>
</div>

<div class="fcols">
<div>
<h2 class="flbl">For families</h2>
<ul>{% for item in nav.footerFamilies %}<li><a href="{{ item.url }}">{{ item.label }}</a></li>{% endfor %}</ul>
</div>
<div>
<h2 class="flbl">More</h2>
<ul>{% for item in nav.footerMore %}<li><a href="{{ item.url }}">{{ item.label }}</a></li>{% endfor %}</ul>
</div>
<div>
<h2 class="flbl">Get in touch</h2>
<ul class="fcontact">
<li><span class="k">Email</span> {% if '[' in site.email %}<span class="todo-inline">{{ site.email }}</span>{% else %}<a href="mailto:{{ site.email }}">{{ site.email }}</a>{% endif %}</li>
<li><span class="k">Phone</span> {% if site.phoneHref %}<a href="tel:{{ site.phoneHref }}">{{ site.phone }}</a>{% else %}<span class="todo-inline">{{ site.phone }}</span>{% endif %}</li>
<li><span class="k">Area</span> {{ site.baseTown }} &amp; {{ site.region }}, {{ site.state }}<br><span class="fine-note">Remote across the {{ site.remoteArea }}</span></li>
{# Existing clients only — paperwork and billing. Deliberately not a booking
   link and deliberately not a CTA: new families phone or email. #}
{% if site.clientPortalUrl %}<li><span class="k">Existing client</span> <a href="{{ site.clientPortalUrl }}">Client portal &rarr;</a></li>{% endif %}
</ul>
</div>
</div>

<div class="base">
<span>© {{ site.yearFounded }} {{ site.businessName }} · {{ site.shortName }}</span>
<span>{{ site.positioning }}</span>
</div>

</div>
</footer>
