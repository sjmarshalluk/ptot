{#
  The shape vocabulary. Five forms, five colours, three sizes, six anchors.

  Usage:  {% from "shape.njk" import shape %}
          {{ shape('blob', 'yellow', 'lg', 'tr') }}
          {{ shape('arch', 'green', 'lg', 'gutter-r', true) }}   <- wash register

  Rules the macro exists to enforce:
  - Saturated shapes never sit behind copy. Pass wash=true for anything that
    will end up under text; the wash tints all clear 4.5:1 with --body, which
    is why no section in this site needs a colour override any more.
  - Anchors bleed a fixed fraction of the shape's OWN width off a corner, so a
    shape is clipped at a corner rather than sliced across a flat edge the way
    hand-placed pixel offsets were.
  - Fills come from tokens, so recolouring the brand is a change to :root and
    not an edit across four templates.
#}

{% macro form(name) %}
{%- if name == 'blob' -%}
<svg viewBox="0 0 320 300"><path d="M28 96C4 32 96-14 176 8c78 22 148 66 140 140-8 76-90 158-176 148C56 286 6 226 20 160c6-28 12-40 8-64Z"/></svg>
{%- elif name == 'arch' -%}
<svg viewBox="0 0 300 320"><path d="M156 6c84-6 140 66 140 152s-52 158-136 160S6 232 6 148C6 68 72 12 156 6Z"/></svg>
{%- elif name == 'triangle' -%}
<svg viewBox="0 0 300 300"><path d="M148 14c6 0 10 3 13 9l132 252c5 10-1 21-12 21H16c-11 0-18-11-13-21L135 23c3-6 7-9 13-9Z"/></svg>
{%- elif name == 'diamond' -%}
<svg viewBox="0 0 300 300"><path d="M143 10c5-5 12-5 17 0l130 130c5 5 5 12 0 17L160 287c-5 5-12 5-17 0L13 157c-5-5-5-12 0-17Z"/></svg>
{%- else -%}
<svg viewBox="0 0 300 300"><path d="M150 4c86 0 146 58 146 140s-64 152-150 152S4 226 4 144 64 4 150 4Z"/></svg>
{%- endif -%}
{% endmacro %}

{#
  Two fills are emitted, not one. --shape-fill is the register asked for;
  --shape-soft is always the wash of the same hue. On narrow screens the
  container spans the full width, so a masthead shape has nowhere to go but
  under the copy — the stylesheet swaps to --shape-soft there rather than
  dropping the shapes and taking the brand off mobile entirely.
#}
{% macro shape(name, color, size='lg', anchor='tr', wash=false) %}
<span class="shape shape-{{ size }} shape-{{ anchor }}" aria-hidden="true"
      style="--shape-fill:var(--{% if wash %}wash-{% endif %}{{ color }});--shape-soft:var(--wash-{{ color }})">{{ form(name) }}</span>
{% endmacro %}
