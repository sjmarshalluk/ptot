{#
  JSON-LD. Deliberately omits streetAddress: this is a service-area practice whose
  address is hidden on its Google Business Profile, and publishing one here would
  contradict that signal. areaServed carries the location instead.

  The top-level areaServed lists ONLY the towns she drives to, because it has to
  stay in step with the Google Business Profile — conflicting location signals
  reduce confidence in the listing. Remote sessions reach much further, so they
  are declared separately, as a Service with its own wider areaServed and an
  availableChannel. Do not merge the two: widening areaServed to cover the remote
  catchment is exactly the desync this file exists to avoid.
#}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "MedicalBusiness",
      "@id": "{{ site.url }}#practice",
      "name": "{{ site.businessName }}",
      "description": "Pediatric occupational therapy in {{ site.baseTown }} and {{ site.region }}, {{ site.stateFull }}. In-home and community-based sessions for children and their families, and remote (telehealth) sessions across the {{ site.remoteArea }}.",
      "url": "{{ site.url }}",
      {% if site.phoneHref %}"telephone": "{{ site.phoneHref }}",{% endif %}
      {% if '[' not in site.email %}"email": "{{ site.email }}",{% endif %}
      "medicalSpecialty": "Occupational Therapy",
      "priceRange": "$$",
      "currenciesAccepted": "USD",
      "areaServed": [
        {% for town in site.serviceArea %}{ "@type": "City", "name": "{{ town }}", "addressRegion": "{{ site.state }}" }{% if not loop.last %},{% endif %}
        {% endfor %}
      ],
      "provider": { "@id": "{{ site.url }}#julia" },
      "availableService": {
        "@type": "Service",
        "@id": "{{ site.url }}#remote",
        "name": "Remote pediatric occupational therapy",
        "serviceType": "Telehealth",
        "description": "Occupational therapy sessions for children, and parent and family consulting, delivered by video.",
        "provider": { "@id": "{{ site.url }}#julia" },
        "areaServed": [
          {% for county in site.remoteCounties %}{ "@type": "AdministrativeArea", "name": "{{ county }} County", "addressRegion": "{{ site.state }}" }{% if not loop.last %},{% endif %}
          {% endfor %}
        ],
        "availableChannel": {
          "@type": "ServiceChannel",
          "name": "Video session",
          "serviceUrl": "{{ '/in-home-ot/#remote' | absolute(site.url) }}"
        }
      },
      "makesOffer": [
        {% for svc in site.services %}{
          "@type": "Offer",
          "itemOffered": { "@type": "Service", "name": "{{ svc.name }}", "serviceType": "Pediatric occupational therapy" },
          "price": "{{ svc.price }}",
          "priceCurrency": "USD"
        }{% if not loop.last %},{% endif %}
        {% endfor %}
      ]
    },
    {
      "@type": "Person",
      "@id": "{{ site.url }}#julia",
      "name": "{{ site.name }}",
      "jobTitle": "{{ site.role }}",
      "url": "{{ '/about/' | absolute(site.url) }}",
      "alumniOf": { "@type": "CollegeOrUniversity", "name": "{{ site.alumniOf }}" },
      "worksFor": { "@id": "{{ site.url }}#practice" }
      {% if '[' not in site.credentials %},
      "hasCredential": {
        "@type": "EducationalOccupationalCredential",
        "credentialCategory": "Professional License",
        "name": "{{ site.credentials }}",
        "recognizedBy": { "@type": "GovernmentOrganization", "name": "{{ site.licenseState }} State Department of Health" }
      }
      {% endif %}
    }{% if faq %},
    {
      "@type": "FAQPage",
      "@id": "{{ page.url | absolute(site.url) }}#faq",
      "mainEntity": [
        {% for item in faq %}{
          "@type": "Question",
          "name": {{ item.q | dump | safe }},
          "acceptedAnswer": { "@type": "Answer", "text": {{ item.a | striptags | dump | safe }} }
        }{% if not loop.last %},{% endif %}
        {% endfor %}
      ]
    }{% endif %}{% if page.url != "/" %},
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "{{ site.url }}" },
        { "@type": "ListItem", "position": 2, "name": {{ (breadcrumb or title) | dump | safe }}, "item": "{{ page.url | absolute(site.url) }}" }
      ]
    }{% endif %}
  ]
}
</script>
